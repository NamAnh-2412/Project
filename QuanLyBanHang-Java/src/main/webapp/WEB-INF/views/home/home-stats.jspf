<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<div class="dashboard-cards">
    <div class="stat-card">
        <div class="label">Đơn hàng hôm nay</div>
        <div class="number">${todayOrders}</div>
    </div>
    <div class="stat-card">
        <div class="label">Khách hàng trong ngày</div>
        <div class="number">${todayCustomers}</div>
    </div>
    <div class="stat-card">
        <div class="label">Doanh thu hôm nay</div>
        <div class="number"><fmt:formatNumber value="${todayRevenue}" pattern="#,##0" />d</div>
    </div>
    <div class="products-hot">
        <h3>Sản phẩm bán chạy</h3>
        <ul class="hot-list">
            <c:choose>
                <c:when test="${not empty topProducts}">
                    <c:forEach var="item" items="${topProducts}" varStatus="loop">
                        <li>
                            <span class="stt">${loop.index + 1}</span>
                            <span class="sp-name">${item.tenSanPham}</span>
                            <span class="sp-count">(${item.tongSoLuong} lượt bán)</span>
                        </li>
                    </c:forEach>
                </c:when>
                <c:otherwise>
                    <li class="nodata">Chưa có dữ liệu</li>
                </c:otherwise>
            </c:choose>
        </ul>
    </div>
</div>
