<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${not empty error}">
    <div class="notice notice-error"><i class="fas fa-exclamation-circle"></i> ${error}</div>
</c:if>
<c:if test="${not empty success}">
    <div class="notice notice-success"><i class="fas fa-check-circle"></i> ${success}</div>
</c:if>
