<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/white"
            tools:text="Nguyễn Thị Lan" />

        <TextView
            android:id="@+id/textCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/text_secondary"
            tools:text="0901 234 567" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/buttonEditCustomer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/customers_cd_edit"
        android:padding="12dp"
        android:src="@drawable/ic_edit_24"
        app:tint="@color/gold_accent"
        tools:ignore="ImageContrastCheck" />

    <ImageButton
        android:id="@+id/buttonDeleteCustomer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/customers_cd_delete"
        android:padding="12dp"
        android:src="@drawable/ic_delete_24"
        app:tint="@color/gold_accent"
        tools:ignore="ImageContrastCheck" />
</LinearLayout>
