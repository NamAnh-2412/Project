<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/white"
            tools:text="Áo thun" />

        <TextView
            android:id="@+id/textProductCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/text_secondary"
            tools:text="Quần áo" />

        <TextView
            android:id="@+id/textStockQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/gold_accent"
            tools:text="Tồn: 12" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/buttonEditProduct"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/stock_product_cd_edit"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_edit_24"
        app:tint="@color/gold_accent" />

    <ImageButton
        android:id="@+id/buttonDeleteProduct"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/stock_product_cd_delete"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_delete_24"
        app:tint="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonStockIn"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stock_product_in_btn"
        android:textColor="@color/gold_accent"
        app:strokeColor="@color/gold_accent" />
</LinearLayout>
