<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/checkout_dialog_bg"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/checkout_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/checkout_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/checkout_text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonHeaderClose"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/checkout_close_cd"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_close_24"
                    app:iconTint="@color/checkout_text_muted" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:minHeight="300dp"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <!-- Hình thức thanh toán -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="138dp"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/checkout_method_cash"
                            style="@style/CheckoutPaymentMethodText"
                            android:text="@string/checkout_method_cash" />

                        <TextView
                            android:id="@+id/checkout_method_qr"
                            style="@style/CheckoutPaymentMethodText"
                            android:text="@string/checkout_method_qr" />

                        <TextView
                            android:id="@+id/checkout_method_grab"
                            style="@style/CheckoutPaymentMethodText"
                            android:text="@string/checkout_method_grab" />

                        <TextView
                            android:id="@+id/checkout_method_shopee"
                            style="@style/CheckoutPaymentMethodText"
                            android:text="@string/checkout_method_shopee" />

                        <TextView
                            android:id="@+id/checkout_method_be"
                            style="@style/CheckoutPaymentMethodText"
                            android:text="@string/checkout_method_be" />

                        <TextView
                            android:id="@+id/checkout_method_bank"
                            style="@style/CheckoutPaymentMethodText"
                            android:text="@string/checkout_method_bank" />

                        <TextView
                            android:id="@+id/checkout_method_pos"
                            style="@style/CheckoutPaymentMethodText"
                            android:text="@string/checkout_method_pos" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp"
                        android:background="@color/checkout_divider" />

                    <!-- Tóm tắt tiền -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="172dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/checkout_total_label"
                                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                android:textColor="@color/checkout_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textTotalMoney"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/checkout_total_red"
                                android:textStyle="bold"
                                tools:text="28.000" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/checkout_customer_pay_label"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/checkout_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textCustomerPay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_checkout_input_field"
                            android:gravity="end|center_vertical"
                            android:minHeight="52dp"
                            android:paddingHorizontal="14dp"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/checkout_text_primary"
                            tools:text="28.000" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/checkout_change_label"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="@color/checkout_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textChangeMoney"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/checkout_text_primary"
                                android:textStyle="bold"
                                tools:text="0" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp"
                        android:background="@color/checkout_divider" />

                    <!-- Bàn phím -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="248dp"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp">

                        <LinearLayout style="@style/CheckoutPaymentKeypadRow">

                            <TextView
                                android:id="@+id/keypad_1"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="1" />

                            <TextView
                                android:id="@+id/keypad_2"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="2" />

                            <TextView
                                android:id="@+id/keypad_3"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="3" />

                            <TextView
                                android:id="@+id/keypad_clear"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="C" />
                        </LinearLayout>

                        <LinearLayout style="@style/CheckoutPaymentKeypadRow">

                            <TextView
                                android:id="@+id/keypad_4"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="4" />

                            <TextView
                                android:id="@+id/keypad_5"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="5" />

                            <TextView
                                android:id="@+id/keypad_6"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="6" />

                            <TextView
                                android:id="@+id/keypad_backspace"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="⌫" />
                        </LinearLayout>

                        <LinearLayout style="@style/CheckoutPaymentKeypadRow">

                            <TextView
                                android:id="@+id/keypad_7"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="7" />

                            <TextView
                                android:id="@+id/keypad_8"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="8" />

                            <TextView
                                android:id="@+id/keypad_9"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="9" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_margin="4dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <LinearLayout style="@style/CheckoutPaymentKeypadRow">

                            <TextView
                                android:id="@+id/keypad_0"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="0" />

                            <TextView
                                android:id="@+id/keypad_00"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="00" />

                            <TextView
                                android:id="@+id/keypad_000"
                                style="@style/CheckoutPaymentKeypadKey"
                                android:text="000" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_margin="4dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/quick_10k"
                                style="@style/CheckoutPaymentQuickChip"
                                android:text="10.000" />

                            <TextView
                                android:id="@+id/quick_20k"
                                style="@style/CheckoutPaymentQuickChip"
                                android:text="20.000" />

                            <TextView
                                android:id="@+id/quick_50k"
                                style="@style/CheckoutPaymentQuickChip"
                                android:text="50.000" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/quick_100k"
                                style="@style/CheckoutPaymentQuickChip"
                                android:text="100.000" />

                            <TextView
                                android:id="@+id/quick_200k"
                                style="@style/CheckoutPaymentQuickChip"
                                android:text="200.000" />

                            <TextView
                                android:id="@+id/quick_500k"
                                style="@style/CheckoutPaymentQuickChip"
                                android:text="500.000" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFooterClose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/checkout_close"
                    android:textAllCaps="false"
                    android:textColor="@color/checkout_surface_white"
                    app:backgroundTint="@color/checkout_footer_dark"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFooterConfirm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:minHeight="52dp"
                    android:text="@string/checkout_confirm"
                    android:textAllCaps="false"
                    android:textColor="@color/checkout_surface_white"
                    app:backgroundTint="@color/checkout_confirm_orange"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
