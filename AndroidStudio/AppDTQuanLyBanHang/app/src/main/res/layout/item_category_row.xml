<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/navy_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/navy_elevated"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="6dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/imageCategoryIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_category_icon_circle"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_cat_food" />

        <TextView
            android:id="@+id/textCategoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/white"
            tools:text="Trà sữa" />

        <LinearLayout
            android:id="@+id/rowCategoryActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditCategory"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_edit_category"
                app:icon="@drawable/ic_edit_24"
                app:iconSize="22dp"
                app:iconTint="@color/gold_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteCategory"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_delete_category"
                app:icon="@drawable/ic_delete_24"
                app:iconSize="22dp"
                app:iconTint="@color/trend_negative" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
